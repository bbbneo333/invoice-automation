# Development/test overrides. The packaged app uses its bundled backend and OS-standard storage.
INVOICE_AUTOMATION_DATA_DIR=/absolute/path/to/application-data
INVOICE_AUTOMATION_CACHE_DIR=/absolute/path/to/cache
INVOICE_AUTOMATION_LOG_DIR=/absolute/path/to/logs
INVOICE_AUTOMATION_CONFIG=/absolute/path/to/application-data/config.json
INVOICE_AUTOMATION_ERROR_LOG=/absolute/path/to/logs/error.log
